# Copy to .env and customize before running `docker compose up`.
# Production on your own server: see docs/DEPLOYMENT.md, then run
# ./scripts/deploy.sh, which refuses to start with the placeholder values below.

# --- Production edge (TLS) ---
# "proxy" starts the bundled Caddy, which gets a Let's Encrypt certificate for
# DOMAIN and listens on 80/443. Leave empty for a local / LAN install.
COMPOSE_PROFILES=
# e.g. quiz.example.com — its DNS A/AAAA record must point at this server.
DOMAIN=

# --- PostgreSQL ---
# Generate with: openssl rand -hex 24   (avoid ; and quotes — it is placed
# inside a connection string)
POSTGRES_PASSWORD=change-me
POSTGRES_DB=openquiz
POSTGRES_USER=openquiz
POSTGRES_PORT=5432
# Published on loopback only; reach it with an SSH tunnel for admin work.
POSTGRES_BIND=127.0.0.1

# --- JWT ---
# Generate a 64-byte random key:  openssl rand -base64 64
JWT_SIGNING_KEY=replace-with-base64-64-bytes
JWT_ISSUER=openquiz
JWT_AUDIENCE=openquiz
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Google Sign-In ---
# Create at https://console.cloud.google.com/apis/credentials → "OAuth 2.0 Client IDs" (Web)
# Authorized JavaScript origins must include PUBLIC_URL.
GOOGLE_CLIENT_ID=

# --- SMTP (optional; required only for password reset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@openquiz.local
SMTP_FROM_NAME=OpenQuiz
SMTP_USE_STARTTLS=true

# --- App ---
ADMIN_EMAIL=
# The address people type. With the proxy profile: https://<DOMAIN>
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# 0.0.0.0 serves the app on every interface (LAN install). Set 127.0.0.1 when
# Caddy or your own reverse proxy on this host is the way in.
WEB_BIND=0.0.0.0
API_PORT=5080
API_BIND=127.0.0.1

# Backend URL the React app calls. Leave empty: nginx in the web container
# reverse-proxies /api and /hubs to the api service, so the frontend uses
# relative URLs and works on any LAN IP/hostname automatically.
VITE_API_BASE_URL=
ASPNETCORE_ENVIRONMENT=Production

# --- Reverse proxy / rate limiting ---
# true only when every request reaches the API through a proxy (always the
# case with the proxy profile). FORWARD_LIMIT is the number of proxy hops:
# 1 for the bundled Caddy, 2 for your own proxy in front of the web container.
TRUST_FORWARDED_HEADERS=false
FORWARD_LIMIT=1
# Requests per minute per address for joining / voting. A whole classroom or
# hall usually shares one NAT address, so size it for the biggest room.
RATE_LIMIT_PARTICIPATION=240

# --- Backups (scripts/backup.sh) ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14

# --- Scale-out (optional) ---
# Required only when more than one api replica runs; SignalR groups do not
# cross processes without it. See docs/SELF_HOSTING.md.
REDIS_CONNECTION_STRING=

# --- Observability (optional) ---
# PROMETHEUS_ENABLED opens an unauthenticated /metrics on the api port; keep
# that port off the public internet. OTLP_ENDPOINT ships metrics and traces to
# a collector, e.g. http://otel-collector:4317
PROMETHEUS_ENABLED=false
OTLP_ENDPOINT=

# --- Billing (optional; off by default) ---
# Every self-hosted install runs unmetered until you opt in here — leaving
# BILLING_ENABLED=false is what makes upgrading this compose file safe.
BILLING_ENABLED=false
# The only registered backend. A Merchant of Record (not a payment gateway)
# will get its own key here when that vendor is chosen — do not set iyzico.
BILLING_PROVIDER=manual
BILLING_DEFAULT_PLAN=unlimited
# Grandfathering: accounts created before this UTC timestamp resolve to
# BILLING_LEGACY_PLAN instead of BILLING_DEFAULT_PLAN. Leave both empty to skip.
BILLING_LEGACY_PLAN=
BILLING_LEGACY_CUTOFF=
BILLING_CURRENCY=TRY
BILLING_WEBHOOK_SECRET=
# Where checkout sends the user back. Empty = App PublicUrl /?billing=contact.
BILLING_CHECKOUT_RETURN_URL=
# Catalog prices (TRY). Shown on the public pricing page; checkout is still manual.
BILLING_PRICE_PRO_MONTHLY=499
BILLING_PRICE_PRO_YEARLY=4990
BILLING_PRICE_TEAM_MONTHLY=1499
BILLING_PRICE_TEAM_YEARLY=14990
# Optional mailto on that contact screen (baked into the web image).
VITE_BILLING_CONTACT_EMAIL=

# --- Container resource limits ---
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.5
WEB_MEMORY_LIMIT=256m
WEB_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_LIMIT=0.5
